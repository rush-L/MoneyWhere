# Browser-safe values only (anon key is public; RLS protects data). Never put service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: where Supabase sends users back after OAuth / email confirmation.
# Defaults to the current origin. Must be in the Supabase Redirect URLs allow-list.
VITE_AUTH_REDIRECT_URL=

# Per environment (set in Vercel / your shell, never commit real values):
#   local dev   : dev Supabase project, leave VITE_AUTH_REDIRECT_URL unset
#   Preview     : dev Supabase project, leave VITE_AUTH_REDIRECT_URL unset (each preview uses its own origin)
#   Production  : production Supabase project, VITE_AUTH_REDIRECT_URL = the canonical origin, no trailing slash
# These are build-time values: changing one needs a new build. SMTP and OAuth secrets belong in the Supabase
# dashboard, never here.
