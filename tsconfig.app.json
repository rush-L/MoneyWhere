{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/client"], "noEmit": true, "isolatedModules": true,
    "tsBuildInfoFile": "./node_modules/.tmp/app.tsbuildinfo"
  },
  "include": ["src"]
}
